@model List<ApplicationUser>

@{
    ViewData["Title"] = "Nhân viên & bác sĩ";
}

<div class="page-title">
    <div>
        <span class="eyebrow">ADMIN</span>
        <h1>Nhân viên &amp; bác sĩ</h1>
    </div>
    <a class="btn" asp-action="Create">+ Tạo tài khoản nội bộ</a>
</div>

<div class="panel">
    <h2>Tài khoản đã tạo</h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Họ tên</th><th>Email</th><th>Điện thoại</th></tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.PhoneNumber</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="panel">
    <h2>Phân ca bác sĩ</h2>
    <p>Chọn bác sĩ, ngày và khung giờ để cho phép đặt lịch.</p>
    <form method="post" asp-action="Shift" class="form-stack form-inline">
        <select name="DoctorId" required>
            <option value="">-- Chọn bác sĩ --</option>
            @foreach (Veterinarian doctor in ViewBag.Doctors)
            {
                <option value="@doctor.Id">@doctor.FullName – @doctor.Specialty</option>
            }
        </select>
        <input type="datetime-local" name="StartAt" required />
        <input type="datetime-local" name="EndAt" required />
        <button type="submit" class="btn">Lưu ca</button>
    </form>

    <div class="table-wrap">
        <table>
            <thead><tr><th>Bác sĩ</th><th>Ca làm việc</th></tr></thead>
            <tbody>
                @foreach (Veterinarian doctor in ViewBag.Doctors)
                {
                    <tr>
                        <td>@doctor.FullName</td>
                        <td>
                            @foreach (var shift in doctor.WorkShifts.OrderBy(item => item.StartAt))
                            {
                                <div>
                                    @shift.StartAt.ToString("dd/MM/yyyy HH:mm") –
                                    @shift.EndAt.ToString("HH:mm")
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

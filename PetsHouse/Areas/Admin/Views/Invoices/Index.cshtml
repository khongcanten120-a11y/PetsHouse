@model List<Invoice>

@{
    ViewData["Title"] = "Hóa đơn";
    var total = (int)ViewBag.Total;
    var currentPage = (int)ViewBag.CurrentPage;
    var perPage = (int)ViewBag.PageSize;
}

<div class="page-title">
    <div>
        <span class="eyebrow">QUẢN TRỊ</span>
        <h1>Hóa đơn thanh toán</h1>
        <p>Chỉ phát sinh khi khám bệnh và kê thuốc; không thu cọc đặt lịch.</p>
    </div>
</div>

<div class="panel">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Mã hóa đơn</th>
                    <th>Khách hàng</th>
                    <th>Thú cưng</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>Chi tiết</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in Model)
                {
                    <tr>
                        <td>#@invoice.Id</td>
                        <td>@invoice.Appointment.Customer.Name</td>
                        <td>@invoice.Appointment.Pet.Name</td>
                        <td>@invoice.Total.ToString("N0") ₫</td>
                        <td>@invoice.Status.ToVietnamese()</td>
                        <td><a asp-action="Details" asp-route-id="@invoice.Id">Xem hóa đơn →</a></td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6">Chưa có hóa đơn nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <nav class="pager">
        @if (currentPage > 1)
        {
            <a asp-action="Index" asp-route-page="@(currentPage - 1)">← Trước</a>
        }
        <span>Trang @currentPage / @Math.Max(1, (int)Math.Ceiling((double)total / perPage))</span>
        @if (currentPage * perPage < total)
        {
            <a asp-action="Index" asp-route-page="@(currentPage + 1)">Sau →</a>
        }
    </nav>
</div>

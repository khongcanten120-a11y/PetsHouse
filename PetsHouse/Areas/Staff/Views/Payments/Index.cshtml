@model List<Appointment>

@{
    ViewData["Title"] = "Chờ thanh toán";
}

<div class="page-title">
    <div>
        <span class="eyebrow">THU NGÂN</span>
        <h1>Danh sách chờ thanh toán</h1>
    </div>
</div>

<div class="panel">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Thú cưng</th>
                    <th>Loại khám</th>
                    <th>Phí khám</th>
                    <th>Tiền thuốc</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model)
                {
                    <tr>
                        <td>#@appointment.Id</td>
                        <td>@appointment.Pet.Name</td>
                        <td>@appointment.ClinicService.Name</td>
                        <td>@appointment.ClinicService.Price.ToString("N0") ₫</td>
                        <td>
                            @((appointment.MedicalRecord?.Prescriptions.Sum(item => item.UnitPrice * item.Quantity) ?? 0).ToString("N0")) ₫
                        </td>
                        <td>
                            <a class="btn btn-small" asp-action="Pay"
                               asp-route-id="@appointment.Id">Thanh toán</a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6">Chưa có ca chờ thanh toán.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

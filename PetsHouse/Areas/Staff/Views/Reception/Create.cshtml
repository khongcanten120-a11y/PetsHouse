@model StaffCustomerCreateVm

@{
    ViewData["Title"] = "Tạo tài khoản khách hàng";
}

<div class="page-title">
    <div>
        <span class="eyebrow">NHÂN VIÊN / TIẾP NHẬN</span>
        <h1>Tạo khách hàng &amp; thú cưng</h1>
        <p>Chỉ tạo tài khoản quyền Khách hàng. Không cần thu cọc để đăng ký khám.</p>
    </div>
    <a class="btn btn-outline" asp-action="Index">← Danh sách</a>
</div>

<div class="panel narrow">
    <form method="post" asp-action="Create" class="form-stack">
        <div asp-validation-summary="All" class="validation"></div>

        <h2>Thông tin chủ nuôi</h2>
        <label asp-for="FullName">Họ và tên *</label>
        <input asp-for="FullName" autocomplete="name" maxlength="100" />
        <span asp-validation-for="FullName" class="validation"></span>

        <label asp-for="Phone">Số điện thoại *</label>
        <input asp-for="Phone" type="tel" maxlength="30" />
        <span asp-validation-for="Phone" class="validation"></span>

        <label asp-for="Email">Email đăng nhập *</label>
        <input asp-for="Email" type="email" maxlength="256" />
        <span asp-validation-for="Email" class="validation"></span>

        <label asp-for="Address">Địa chỉ</label>
        <input asp-for="Address" maxlength="200" />

        <label asp-for="TemporaryPassword">Mật khẩu ban đầu *</label>
        <input asp-for="TemporaryPassword" type="password" autocomplete="new-password" />
        <span asp-validation-for="TemporaryPassword" class="validation"></span>
        <p class="muted">Tối thiểu 8 ký tự, gồm chữ hoa, số và ký tự đặc biệt theo chính sách hệ thống.</p>

        <h2>Hồ sơ thú cưng</h2>
        <label asp-for="PetName">Tên thú cưng *</label>
        <input asp-for="PetName" maxlength="80" />

        <label asp-for="Species">Loài *</label>
        <select asp-for="Species">
            <option value="">-- Chọn loài --</option>
            <option value="Chó">Chó</option>
            <option value="Mèo">Mèo</option>
            <option value="Khác">Khác</option>
        </select>

        <label asp-for="Breed">Giống</label>
        <input asp-for="Breed" maxlength="80" />

        <label asp-for="Gender">Giới tính</label>
        <select asp-for="Gender">
            <option value="">Chưa xác định</option>
            <option value="Đực">Đực</option>
            <option value="Cái">Cái</option>
        </select>

        <button class="btn" type="submit">Lưu khách hàng và thú cưng</button>
    </form>
</div>

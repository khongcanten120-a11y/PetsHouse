@model List<StockMovement>

@{
    ViewData["Title"] = "Nhật ký nhập xuất kho";
}

<div class="page-title">
    <div>
        <span class="eyebrow">QUẢN LÝ KHO</span>
        <h1>Lịch sử nhập – xuất thuốc</h1>
        <p>150 biến động gần nhất đã ghi vào SQL Server.</p>
    </div>
    <a asp-area="Warehouse" asp-controller="Dashboard" asp-action="Index">
        ← Kho thuốc
    </a>
</div>

<div class="panel">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Thời điểm</th>
                    <th>Thuốc</th>
                    <th>Số lượng thay đổi</th>
                    <th>Lý do</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var movement in Model)
                {
                    <tr>
                        <td>#@movement.Id</td>
                        <td>@movement.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@movement.Medicine.Name</td>
                        <td>
                            <span class="pill @(movement.QuantityChange < 0 ? "warning" : "")">
                                @(movement.QuantityChange > 0 ? "+" : "")@movement.QuantityChange
                            </span>
                        </td>
                        <td>@movement.Reason</td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5">Chưa phát sinh nhập hoặc xuất kho.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

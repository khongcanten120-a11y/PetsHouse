@model List<Appointment>

@{
    ViewData["Title"] = "Lịch hẹn của tôi";
    var cancelDeadline = DateTime.Now.AddHours(24);
}

<div class="page-title">
    <div>
        <span class="eyebrow">LỊCH KHÁM</span>
        <h1>Lịch hẹn của tôi</h1>
        <p>Chỉ được hủy khi còn ít nhất 24 giờ trước giờ khám.</p>
    </div>

    <a class="btn" asp-action="Create">+ Đặt lịch mới</a>
</div>

@if (TempData["Success"] is string successMessage)
{
    <div class="panel" style="margin-bottom: 16px; border-left: 4px solid #15965d;">
        <strong style="color: #087d48;">@successMessage</strong>
    </div>
}

@if (TempData["Error"] is string errorMessage)
{
    <div class="panel" style="margin-bottom: 16px; border-left: 4px solid #db4a4a;">
        <strong style="color: #bd3030;">@errorMessage</strong>
    </div>
}

<div class="panel">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Thú cưng</th>
                    <th>Loại khám</th>
                    <th>Bác sĩ</th>
                    <th>Thời gian</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model)
                {
                    var canCancel = appointment.StartsAt >= cancelDeadline &&
                        (appointment.Status == AppointmentStatus.Pending ||
                         appointment.Status == AppointmentStatus.Confirmed ||
                         appointment.Status == AppointmentStatus.Waiting);

                    var alreadyFinished = appointment.Status == AppointmentStatus.Completed ||
                        appointment.Status == AppointmentStatus.AwaitingPayment ||
                        appointment.Status == AppointmentStatus.InProgress;

                    <tr>
                        <td>#@appointment.Id</td>
                        <td>@appointment.Pet.Name</td>
                        <td>@appointment.ClinicService.Name</td>
                        <td>@(appointment.Veterinarian?.FullName ?? "Chưa phân công")</td>
                        <td>@appointment.StartsAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="pill">@appointment.Status.ToVietnamese()</span></td>
                        <td>
                            @if (canCancel)
                            {
                                <form method="post" asp-action="Cancel"
                                      asp-route-id="@appointment.Id">
                                    <button type="submit"
                                            class="btn btn-small btn-outline"
                                            onclick="return confirm('Bạn có chắc muốn hủy lịch khám này?')">
                                        Hủy khám
                                    </button>
                                </form>
                            }
                            else if (appointment.Status == AppointmentStatus.Canceled)
                            {
                                <span class="pill">Đã hủy</span>
                            }
                            else if (alreadyFinished)
                            {
                                <span style="color: #66758b;">Không thể hủy</span>
                            }
                            else
                            {
                                <button type="button" class="btn btn-small btn-outline"
                                        disabled title="Chỉ được hủy trước giờ khám ít nhất 24 giờ">
                                    Quá hạn hủy
                                </button>
                            }
                        </td>
                    </tr>
                }

                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7">Chưa có lịch hẹn nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

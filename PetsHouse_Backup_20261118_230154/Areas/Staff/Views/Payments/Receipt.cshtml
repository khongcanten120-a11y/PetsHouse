@model Invoice

@{
    ViewData["Title"] = "Hóa đơn đã thanh toán";
}

<div class="page-title">
    <div>
        <span class="eyebrow">THU NGÂN</span>
        <h1>Hóa đơn #@Model.Id</h1>
        <p>Thanh toán đã ghi nhận vào SQL Server.</p>
    </div>
    <div class="card-actions">
        <a class="btn btn-outline" asp-action="Index">← Danh sách</a>
        <button class="btn" type="button" onclick="window.print()">In hóa đơn</button>
    </div>
</div>

<div class="panel receipt">
    <div class="receipt-heading">
        <h2>🐾 Pets House – Phòng khám thú cưng</h2>
        <p>HÓA ĐƠN SAU KHÁM #@Model.Id</p>
    </div>

    <p><strong>Chủ nuôi:</strong> @Model.Appointment.Customer.Name</p>
    <p><strong>Thú cưng:</strong> @Model.Appointment.Pet.Name</p>
    <p>
        <strong>Thời gian thanh toán:</strong>
        @(Model.PaidAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
    </p>
    <p><strong>Phương thức:</strong> @Model.PaymentMethod</p>

    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Nội dung</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Description</td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitPrice.ToString("N0") ₫</td>
                        <td>@((item.Quantity * item.UnitPrice).ToString("N0")) ₫</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="receipt-footer">Tổng: @Model.Total.ToString("N0") ₫</p>
    <p class="muted">
        Đã thu: @Model.AmountTendered.ToString("N0") ₫ ·
        Tiền thối: @(Math.Max(0m, Model.AmountTendered - Model.Total).ToString("N0")) ₫
    </p>
    <p class="muted">Không thu tiền đặt cọc khi khách hàng tạo lịch hẹn.</p>
</div>

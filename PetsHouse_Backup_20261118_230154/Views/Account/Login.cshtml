@model LoginVm

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-page">
    <div class="auth-image">
        <span class="eyebrow">CHÀO MỪNG TRỞ LẠI</span>
        <h2>Pets House luôn bên cạnh người bạn nhỏ!</h2>
        <p>Quản lý hồ sơ thú cưng và lịch khám thuận tiện.</p>
        <div class="auth-illustration">
            <svg class="icon icon-paw"><use href="/images/icons.svg#paw"></use></svg>
        </div>
    </div>

    <div class="auth-card">
        <span class="eyebrow">TÀI KHOẢN</span>
        <h1>Đăng nhập</h1>
        <p>Vui lòng nhập thông tin để tiếp tục.</p>

        <form method="post" asp-action="Login" class="form-stack">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <label asp-for="Email">Địa chỉ email</label>
            <input asp-for="Email" placeholder="email@example.com" autocomplete="username" />
            <span asp-validation-for="Email" class="validation"></span>

            <label asp-for="Password">Mật khẩu</label>
            <input asp-for="Password" placeholder="••••••••" autocomplete="current-password" />
            <span asp-validation-for="Password" class="validation"></span>

            <button class="btn btn-block" type="submit">Đăng nhập →</button>
        </form>

        <p class="auth-foot">
            Chưa có tài khoản?
            <a asp-action="Register">Đăng ký tại đây</a>
        </p>
    </div>
</div>

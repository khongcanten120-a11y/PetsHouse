@model ExamineVm

@{
    ViewData["Title"] = "Phiếu khám bệnh";
    var appointment = (Appointment)ViewBag.Appointment;
}

<div class="page-title">
    <div>
        <span class="eyebrow">BÁC SĨ THÚ Y</span>
        <h1>Khám bệnh – @appointment.Pet.Name</h1>
        <p>
            Mã ca #@appointment.Id ·
            Lịch khám @appointment.StartsAt.ToString("dd/MM/yyyy HH:mm")
        </p>
    </div>
    <a asp-area="Doctor" asp-controller="Dashboard" asp-action="Index">
        ← Danh sách
    </a>
</div>

<div class="panel">
    <div class="detail-grid">
        <div>
            <span class="muted">Thú cưng</span>
            <h3>@appointment.Pet.Name (@appointment.Pet.Species)</h3>
        </div>
        <div>
            <span class="muted">Ghi chú đặt lịch</span>
            <p>@(appointment.Notes ?? "Không có ghi chú")</p>
        </div>
    </div>
</div>

<div class="panel">
    <form method="post" asp-action="Create" class="form-stack">
        <input asp-for="AppointmentId" type="hidden" />
        <div asp-validation-summary="All" class="validation"></div>

        <label asp-for="Symptoms">Triệu chứng *</label>
        <textarea asp-for="Symptoms" rows="3" required></textarea>
        <span asp-validation-for="Symptoms" class="validation"></span>

        <label asp-for="Diagnosis">Chẩn đoán *</label>
        <textarea asp-for="Diagnosis" rows="3" required></textarea>
        <span asp-validation-for="Diagnosis" class="validation"></span>

        <label asp-for="Treatment">Hướng điều trị</label>
        <textarea asp-for="Treatment" rows="3"></textarea>

        <div class="section-bar">
            <h2>Kê thuốc</h2>
            <button class="btn btn-outline btn-small" id="addMedicine" type="button">
                + Thêm dòng thuốc
            </button>
        </div>
        <p class="muted">
            Không bắt buộc kê thuốc. Mỗi dòng chọn một loại thuốc khác nhau.
        </p>

        <div id="medicinesList">
            @for (var index = 0; index < Model.Items.Count; index++)
            {
                <div class="medicinerow" data-index="@index">
                    <label for="Items_@(index)__MedicineId">Thuốc</label>
                    <select name="Items[@index].MedicineId" id="Items_@(index)__MedicineId">
                        <option value="">Không chọn thuốc</option>
                        @foreach (Medicine medicine in ViewBag.Medicines)
                        {
                            <option value="@medicine.Id"
                                    selected="@(medicine.Id == Model.Items[index].MedicineId)">
                                @medicine.Name · tồn @medicine.QuantityOnHand @medicine.Unit ·
                                @medicine.UnitPrice.ToString("N0") ₫
                            </option>
                        }
                    </select>

                    <label for="Items_@(index)__Quantity">Số lượng</label>
                    <input id="Items_@(index)__Quantity" name="Items[@index].Quantity"
                           type="number" min="1" value="@Model.Items[index].Quantity" />

                    <label for="Items_@(index)__Directions">Hướng dẫn sử dụng</label>
                    <input id="Items_@(index)__Directions" name="Items[@index].Directions"
                           type="text" maxlength="400" value="@Model.Items[index].Directions" />
                </div>
            }
        </div>

        <div class="alert" role="note">
            Chỉ lưu đơn thuốc, chưa trừ kho. Nhân viên kho cấp phát sau khi kiểm tra.
        </div>

        <button type="submit" class="btn"
                onclick="return confirm('Lưu bệnh án và chuyển chờ thanh toán?');">
            Lưu bệnh án và đơn thuốc
        </button>
    </form>
</div>

<template id="medicineTemplate">
    <div class="medicinerow">
        <label>Thuốc</label>
        <select name="Items[__INDEX__].MedicineId">
            <option value="">Không chọn thuốc</option>
            @foreach (Medicine medicine in ViewBag.Medicines)
            {
                <option value="@medicine.Id">
                    @medicine.Name · tồn @medicine.QuantityOnHand @medicine.Unit
                </option>
            }
        </select>
        <label>Số lượng</label>
        <input name="Items[__INDEX__].Quantity" type="number" min="1" />
        <label>Hướng dẫn sử dụng</label>
        <input name="Items[__INDEX__].Directions" maxlength="400" />
    </div>
</template>

@section Scripts {
    <script>
        document.getElementById("addMedicine")?.addEventListener("click", function () {
            const list = document.getElementById("medicinesList");
            const template = document.getElementById("medicineTemplate");

            if (!list || !template) {
                return;
            }

            const index = list.querySelectorAll(".medicinerow").length;

            if (index >= 15) {
                alert("Tối đa 15 dòng thuốc trong một phiếu.");
                return;
            }

            list.insertAdjacentHTML(
                "beforeend",
                template.innerHTML.replaceAll("__INDEX__", String(index))
            );
        });
    </script>
}
